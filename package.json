{
  "name": "engineers-vault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/database.js migrate",
    "db:seed": "node --env-file-if-exists=.env scripts/database.js seed",
    "admin:grant": "node --env-file-if-exists=.env scripts/admin.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "format": "prettier --write public server scripts tests"
  },
  "dependencies": { "express": "^5.3.0", "pg": "^8.23.1" },
  "devDependencies": { "embedded-postgres": "18.4.0-beta.17", "prettier": "^3.6.2" }
}
